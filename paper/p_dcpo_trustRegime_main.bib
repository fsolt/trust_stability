@article{KarvEtAl2022,
  title = {How Context Matters: The Significance of Political Homogeneity and Language for Political Efficacy},
  shorttitle = {How Context Matters},
  author = {Karv, Thomas and Lindell, Marina and Rapeli, Lauri},
  date = {2022},
  journaltitle = {Scandinavian Political Studies},
  shortjournal = {Scand Polit Stud},
  volume = {45},
