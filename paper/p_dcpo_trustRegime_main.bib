  shorttitle = {The Decline in Diffuse Support for National Politics},
  author = {Jennings, Will and Clarke, Nick and Moss, Jonathan and Stoker, Gerry},
  date = {2017-09-07},
  journaltitle = {Public Opinion Quarterly},
  shortjournal = {Public Opinion Quarterly},
