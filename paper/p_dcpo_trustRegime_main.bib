@article{Craig1982,
	abstract = {Numerous studies raise the problems of dimensionality in the original conceptualization and measurement of "sense of political efficacy." Although the distinction between "internal" and "external" efficacy now is widely employed, serious problems result when the six-item CPS efficacy battery is used to measure both dimensions. We contend that the CPS approach may create problems of interpretation as serious as those caused by a failure to recognize the internal-external distinction. Internal efficacy cannot be operationalized adequately using the standard six-item index, and we propose an alternative measure.},
