@article{MattesBratton2007,
  title = {Learning about Democracy in Africa: Awareness, Performance, and Experience},
  shorttitle = {Learning about Democracy in Africa},
  author = {Mattes, Robert and Bratton, Michael},
  date = {2007},
  journaltitle = {American Journal of Political Science},
  volume = {51},
